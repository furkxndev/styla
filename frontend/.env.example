# Backend'e bağlanmak için bu dosyayı .env olarak kopyala.
# Expo yalnızca EXPO_PUBLIC_ önekli değişkenleri istemciye taşır.
#
# UYARI: EXPO_PUBLIC_ önekli her değer uygulama paketine gömülür ve okunabilir.
# Buraya ASLA API anahtarı (OpenRouter vb.) yazma — AI çağrıları backend üzerinden yapılır.

# true  : backend olmadan yerel sahte API ile çalışır (demo verisi)
# false : tüm istekler EXPO_PUBLIC_API_URL adresine gider
EXPO_PUBLIC_USE_MOCK_API=false

# Backend adresi.
# Fiziksel telefon/emülatör bilgisayarının "localhost"una ULAŞAMAZ; LAN IP kullan:
#   macOS : ipconfig getifaddr en0
#   Linux : hostname -I | awk '{print $1}'
# Telefon ve bilgisayar aynı Wi-Fi ağında olmalı.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
