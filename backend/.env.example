# =============================================================================
# Kombin Backend - ornek environment dosyasi
# Kullanim: cp .env.example .env  ve degerleri kendi ortamina gore doldur.
# Bu dosya GERCEK SIR ICERMEZ; sadece placeholder degerler barindirir.
# =============================================================================

# -----------------------------------------------------------------------------
# UYGULAMA
# -----------------------------------------------------------------------------

# Calisma ortami: development | production | test
NODE_ENV=development

# HTTP sunucusunun dinledigi port
PORT=4000

# Tum endpoint'lerin onune eklenen global prefix (frontend api/v1 bekliyor)
API_PREFIX=api/v1

# CORS'a izin verilen origin listesi; virgulle ayrilir, * = herkese acik
CORS_ORIGINS=*

# Yuklenen gorsellerin mutlak URL'ini uretmek icin kullanilan dis adres
# (mobil cihazdan erisilebilir olmali; localhost telefondan cozulmez)
PUBLIC_URL=http://localhost:4000

# Swagger dokumantasyonu (/docs) acik mi? Uretimde false onerilir
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# VERITABANI (PostgreSQL)
# -----------------------------------------------------------------------------

# Docker compose ile calisirken bu deger "postgres" olmalidir (servis adi)
DB_HOST=localhost

# PostgreSQL portu.
# ONEMLI: Bilgisayarinda zaten yerel bir PostgreSQL 5432'yi kullaniyorsa
# burayi 5433 gibi bos bir porta al. docker-compose bu degeri HOST portu olarak
# yayinlar (5433:5432); compose icindeki api servisi her zaman 5432 kullanir.
DB_PORT=5432

# Veritabani kullanici adi
DB_USERNAME=kombin

# Veritabani parolasi - uretimde guclu bir deger kullan
DB_PASSWORD=kombin_dev_password

# Veritabani adi
DB_DATABASE=kombin

# TypeORM semayi otomatik olustursun mu? Gelistirmede true, URETIMDE MUTLAKA false
DB_SYNCHRONIZE=true

# Calistirilan SQL sorgularini konsola yaz (gurultulu, sadece hata ayiklamada)
DB_LOGGING=false

# Yonetilen bir veritabanina (Neon, Supabase, RDS) baglanirken true
DB_SSL=false

# DB_SSL=true iken sertifika dogrulamasi ACIK kalir. Yonetilen veritabanin
# self-signed sertifika kullaniyorsa CA sertifikasini buraya yapistir.
# DB_SSL_CA=

# -----------------------------------------------------------------------------
# JWT / KIMLIK DOGRULAMA
# Secret uretmek icin: openssl rand -hex 32
# Access ve refresh secret'lari FARKLI olmali; asla depoya commit'leme.
# -----------------------------------------------------------------------------

# Access token imza anahtari (en az 32 karakter) - openssl rand -hex 32 ile uret
JWT_ACCESS_SECRET=degistir_openssl_rand_hex_32_ile_uretilmis_access_secret

# Refresh token imza anahtari (en az 32 karakter) - openssl rand -hex 32 ile uret
JWT_REFRESH_SECRET=degistir_openssl_rand_hex_32_ile_uretilmis_refresh_secret

# Access token gecerlilik suresi (ms formati: 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=1h

# Refresh token gecerlilik suresi
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# YONETIM (ADMIN PANELI)
# -----------------------------------------------------------------------------

# Bu e-postaya sahip kullanici, uygulama her acilista otomatik olarak 'admin'
# rolune yukseltilir. Boylece panele erisim icin veritabanina elle mudahale
# gerekmez: once normal yoldan kayit ol, sonra bu degeri doldurup yeniden baslat.
# Bos birakilirsa hicbir kullanici otomatik admin olmaz.
# NOT: Bu hesap henuz kayitli degilse acilista sessizce atlanir; kayit olduktan
# sonraki ilk baslatmada yetki verilir.
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# AI (kombin onerisi, kiyafet analizi, stil asistani)
# Anahtar SADECE backend'de durur; frontend'e hicbir zaman gonderilmez.
# -----------------------------------------------------------------------------

# Aktif AI saglayicisi. Su an desteklenen: openrouter
AI_PROVIDER=openrouter

# OpenRouter API anahtari - https://openrouter.ai/keys adresinden alinir
OPENROUTER_API_KEY=<openrouter-api-anahtarin>

# OpenRouter API taban adresi
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Metin gorevlerinde (kombin uretimi, asistan) kullanilan model
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Gorsel analizinde kullanilan model (bos birakilirsa OPENROUTER_MODEL kullanilir)
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5

# OpenRouter siralamalarinda gorunmek icin opsiyonel uygulama adresi
OPENROUTER_APP_URL=https://kombin.app

# OpenRouter siralamalarinda gorunen uygulama basligi
OPENROUTER_APP_TITLE=Kombin

# Tek bir AI cagrisi icin zaman asimi (ms)
OPENROUTER_TIMEOUT_MS=60000

# Gecici hatalarda (429/5xx) yeniden deneme sayisi
OPENROUTER_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# HAVA DURUMU (Open-Meteo - API anahtari gerektirmez)
# -----------------------------------------------------------------------------

# Guncel hava durumu endpoint'i
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Sehir adindan koordinat cozumleyen geocoding endpoint'i
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Ayni konum icin sonucun bellekte tutuldugu sure (ms) - varsayilan 30 dakika
WEATHER_CACHE_TTL_MS=1800000

# Hava durumu isteginin zaman asimi (ms)
WEATHER_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# DOSYA DEPOLAMA
# -----------------------------------------------------------------------------

# Depolama surucusu: local (diske yazar). Ileride s3 eklenecek
STORAGE_DRIVER=local

# local surucude gorsellerin yazildigi klasor (Docker'da volume ile eslenir)
STORAGE_LOCAL_DIR=uploads

# Yuklenebilecek en buyuk dosya boyutu (MB)
STORAGE_MAX_FILE_SIZE_MB=8

# -----------------------------------------------------------------------------
# HIZ SINIRLAMA (throttler)
# -----------------------------------------------------------------------------

# Sayac penceresi (ms)
THROTTLE_TTL_MS=60000

# Pencere basina genel istek limiti
THROTTLE_LIMIT=120

# AI uclari icin daha dusuk limit (maliyet kontrolu)
THROTTLE_AI_LIMIT=20

# Sunucu saat dilimi - sabah kombini gorevi bu saate gore calisir
TZ=Europe/Istanbul

# Sabah kombini gorevi acik mi (her 15 dakikada bir kontrol eder)
DAILY_OUTFIT_JOB_ENABLED=true
